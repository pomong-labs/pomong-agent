# Pomong Agent — environment example
# Copy to .env (docker compose reads it automatically) and adjust.
# Never commit real secrets. API keys are normally added in the setup wizard
# and stored encrypted in ./data, so they do not belong here.

# Port the Node server listens on inside the container / on the host loopback.
PORT=3100

# Directory for the SQLite database, setup token and encryption keys.
DATA_DIR=./data

# Timezone used for logs and the UI.
TZ=Asia/Seoul

# Set to production when serving the built bundle.
NODE_ENV=production

# Optional: bind address (default 0.0.0.0 inside the container).
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Phase 2 — 자율 웹 브라우저 (선택 프로필)
# ---------------------------------------------------------------------------
# 브라우저 워커를 띄우려면: docker compose --profile browser up -d
# 워커 주소(도커 내부 네트워크). 외부에 포트를 노출하지 않는다.
BROWSER_WS_URL=ws://browser:9222/
# 0 으로 두면 브라우저 도구가 꺼진다(메모리를 아끼고 싶을 때).
BROWSER_ENABLED=1
# 워커 감독(시작·정지·유휴 회수) 제어 주소 — 내부 네트워크 전용.
BROWSER_CONTROL_URL=http://browser:9223/
